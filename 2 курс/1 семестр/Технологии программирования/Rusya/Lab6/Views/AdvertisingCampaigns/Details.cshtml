@model AdvertisingCampaign

@{
    ViewData["Title"] = "Информация о проекте";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-building"></i> Информация о проекте
                    </h2>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8">@Model.id</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.name):</dt>
                                <dd class="col-sm-8">@Model.name</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.description):</dt>
                                <dd class="col-sm-8">@Model.description</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.startDate):</dt>
                                <dd class="col-sm-8">@Model.startDate.ToString("dd.MM.yyyy")</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.endDate):</dt>
                                <dd class="col-sm-8">@Model.endDate.ToString("dd.MM.yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <dt>@Html.DisplayNameFor(model => model.budget):</dt>
                            <dd>@Model.budget</dd>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <dt>@Html.DisplayNameFor(model => model.status):</dt>
                            <dd>@Model.status.name</dd>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <h5 class="mb-3">
                                <i class="fas fa-bullhorn"></i> Проект клиента №:
                                <span class="badge bg-secondary">@Model.client.id</span>
                            </h5>

                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Наименование компании</th>
                                        <th>Контактное лицо</th>
                                        <th>Email</th>
                                        <th>Телефон</th>
                                        <th>Адрес</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>@Model.client.companyName</td>
                                        <td>@Model.client.contactPerson</td>
                                        <td>@Model.client.email</td>
                                        <td>@Model.client.phone</td>
                                        <td>@Model.client.address</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <h5 class="mb-3">
                                <i class="fas fa-bullhorn"></i> Задачи проекта:
                                <span class="badge bg-secondary">@Model.tasks.Count</span>
                            </h5>

                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Задача</th>
                                        <th>Срок</th>
                                        <th>Статус</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach(var task in Model.tasks){
                                        <tr>
                                            <td>@task.title</td>
                                            <td>@task.deadline</td>
                                            <td>@task.status.name</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-group" role="group">
                        <a asp-controller="AdvertisingCampaigns" asp-action="EditPage" asp-route-id="@Model.id"
                           class="btn btn-warning">
                            <i class="fas fa-edit"></i> Редактировать
                        </a>
                        <a asp-controller="AdvertisingCampaigns" asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>