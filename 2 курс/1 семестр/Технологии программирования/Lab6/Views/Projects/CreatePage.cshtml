@model Lab6.Models.ViewModels.ProjectViewModel

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h4 class="card-title mb-0">
            <i class="bi bi-plus-circle me-2"></i>Создание нового проекта
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" asp-controller="Projects" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="@Model.project.name" class="form-control" placeholder=" " />
                        <label asp-for="@Model.project.name" class="form-label">Название проекта</label>
                        <span asp-validation-for="@Model.project.name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating">
                        <textarea asp-for="@Model.project.description" class="form-control" placeholder=" " style="height: 100px"></textarea>
                        <label asp-for="@Model.project.description" class="form-label">Описание</label>
                        <span asp-validation-for="@Model.project.description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="@Model.project.startDate" type="date" class="form-control" placeholder=" " />
                        <label asp-for="@Model.project.startDate" class="form-label">Дата начала</label>
                        <span asp-validation-for="@Model.project.startDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="@Model.project.endDate" type="date" class="form-control" placeholder=" " />
                        <label asp-for="@Model.project.endDate" class="form-label">Дата окончания</label>
                        <span asp-validation-for="@Model.project.endDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="@Model.project.budget" class="form-control" placeholder=" " type="number" step="0.01" />
                        <label asp-for="@Model.project.budget" class="form-label">Бюджет</label>
                        <span asp-validation-for="@Model.project.budget" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="status.id" asp-items="@(new SelectList(Model.statuses, "id", "name"))"
                                class="form-select">
                            <option value="">Выберите статус</option>
                        </select>
                        <label asp-for="status.id" class="form-label">Статус проекта</label>
                        <span asp-validation-for="status.id" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating">
                        <select asp-for="client.id" asp-items="@(new SelectList(Model.clients, "id", "companyName"))"
                                class="form-select">
                            <option value="">Выберите клиента</option>
                        </select>
                        <label asp-for="client.id" class="form-label">Клиент</label>
                        <span asp-validation-for="client.id" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-lg me-2"></i>Создать проект
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Вернуться к списку
                </a>
            </div>
        </form>
    </div>
</div>