@model Lab6.Models.ViewModels.TaskViewModel

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h4 class="card-title mb-0">
            <i class="bi bi-plus-circle me-2"></i>Создание новой задачи
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" asp-controller="Tasks" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="@Model.task.title" class="form-control" placeholder=" " />
                        <label asp-for="@Model.task.title" class="form-label">Название задачи</label>
                        <span asp-validation-for="@Model.task.title" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-floating">
                        <textarea asp-for="@Model.task.description" class="form-control" placeholder=" " style="height: 100px"></textarea>
                        <label asp-for="@Model.task.description" class="form-label">Описание задачи</label>
                        <span asp-validation-for="@Model.task.description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="@Model.task.deadline" type="date" class="form-control" placeholder=" " />
                        <label asp-for="@Model.task.deadline" class="form-label">Срок выполнения</label>
                        <span asp-validation-for="@Model.task.deadline" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="@Model.task.assignedTo" class="form-control" placeholder=" " />
                        <label asp-for="@Model.task.assignedTo" class="form-label">Исполнитель</label>
                        <span asp-validation-for="@Model.task.assignedTo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="status.id" asp-items="@(new SelectList(Model.statuses, "id", "name"))"
                                class="form-select">
                            <option value="">Выберите статус</option>
                        </select>
                        <label asp-for="status.id" class="form-label">Статус задачи</label>
                        <span asp-validation-for="status.id" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="project.id" asp-items="@(new SelectList(Model.projects, "id", "name"))"
                                class="form-select">
                            <option value="">Выберите проект</option>
                        </select>
                        <label asp-for="project.id" class="form-label">Проект</label>
                        <span asp-validation-for="project.id" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-lg me-2"></i>Создать задачу
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i>Вернуться к списку
                </a>
            </div>
        </form>
    </div>
</div>