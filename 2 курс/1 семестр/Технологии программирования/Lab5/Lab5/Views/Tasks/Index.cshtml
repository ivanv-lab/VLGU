@model List<Tasks>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">
            <i class="bi bi-list-task me-2"></i>Список задач
        </h4>
        <a asp-action="CreatePage" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Добавить задачу
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-card-text me-1"></i>Наименование задачи</th>
                        <th><i class="bi bi-calendar-check me-1"></i>Срок выполнения</th>
                        <th><i class="bi bi-circle-fill me-1"></i>Статус</th>
                        <th><i class="bi bi-kanban me-1"></i>Проект</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count != 0)
                    {
                        foreach (Tasks task in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@task.title</td>
                                <td>
                                    <span class="@task.deadline">
                                        <i class="bi bi-calendar me-1"></i>@task.deadline.ToString("dd.MM.yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge
                                                @(task.status.name == "Выполнено" ? "bg-success" :
                                                                                    task.status.name == "В работе" ? "bg-primary" :
                                                                                    task.status.name == "Новая" ? "bg-info" :
                                                                                    task.status.name == "Отложено" ? "bg-warning" :
                                                                                    "bg-secondary")">
                                        @task.status.name
                                    </span>
                                </td>
                                <td>@task.project.name</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-controller="Tasks" asp-route-id="@task.id"
                                           class="btn btn-outline-info" title="Подробнее">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-controller="Tasks" asp-route-id="@task.id"
                                           class="btn btn-outline-danger" title="Удалить"
                                           onclick="return confirm('Вы уверены, что хотите удалить эту задачу?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                                Задачи не найдены
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>