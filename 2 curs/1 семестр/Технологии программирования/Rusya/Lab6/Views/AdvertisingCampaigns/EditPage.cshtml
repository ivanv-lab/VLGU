@model Lab6.Models.ViewModels.CreateCampaignViewModel

<h2>Редактирование проекта</h2>

<form asp-action="Edit" asp-route-id="@Model.campaign.id" method="post">
    @Html.AntiForgeryToken()
    
    <div class="form-group">
        <label asp-for="campaign.name" class="control-label"></label>
        <input asp-for="campaign.name" class="form-control"/>
        <span asp-validation-for="campaign.name" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="campaign.description" class="control-label"></label>
        <input asp-for="campaign.description" class="form-control"/>
        <span asp-validation-for="campaign.description" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="@Model.campaign.startDate" class="control-label"></label>
        <input asp-for="@Model.campaign.startDate" type="date" class="form-control" />
        <span asp-validation-for="@Model.campaign.startDate" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="@Model.campaign.endDate" class="control-label"></label>
        <input asp-for="@Model.campaign.endDate" type="date" class="form-control" />
        <span asp-validation-for="@Model.campaign.endDate" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="campaign.budget" class="control-label"></label>
        <input asp-for="campaign.budget" class="form-control"/>
        <span asp-validation-for="campaign.budget" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="@Model.status.name" class="control-label"></label>
        <select asp-for="status.id" asp-items="@(new SelectList(Model.statuses, "id", "name"))"
                class="form-control">
            <option value="">Выберите статус</option>
        </select>
        <span asp-validation-for="status.id" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="@Model.client.companyName" class="control-label"></label>
        <select asp-for="client.id" asp-items="@(new SelectList(Model.clients, "id", "companyName"))"
                class="form-control">
            <option value="">Выберите клиента</option>
        </select>
        <span asp-validation-for="client.id" class="text-danger"></span>
    </div>
    
    <div class="form-group mt-4">
        <button type="submit" class="btn btn-success">Редактировать</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>