@model List<AdvertisingCampaign>

<a asp-action="CreatePage" class="btn btn-primary">Добавить</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Наименование проекта</th>
        <th>Бюджет</th>
        <th>Начало</th>
        <th>Окончание</th>
        <th>Статус</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Count != 0)
    {
        foreach (AdvertisingCampaign campaign in Model)
        {
            <tr>
                <td>@campaign.name</td>
                <td>@campaign.budget.ToString("C")</td>
                <td>@campaign.startDate.ToString("dd.MM.yyyy")</td>
                <td>@campaign.endDate.ToString("dd.MM.yyyy")</td>
                <td>@campaign.status.name</td>
                <td>
                    <a asp-action="Delete" asp-controller="AdvertisingCampaigns" asp-route-id="@campaign.id" class="btn btn-sm btn-danger">Удалить</a>
                    <a asp-action="Details" asp-controller="AdvertisingCampaigns" asp-route-id="@campaign.id" class="btn btn-sm btn-info">Подробно</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>