@model List<Tasks>

<a asp-action="CreatePage" class="btn btn-primary">Добавить</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Наименование задачи</th>
        <th>Срок до</th>
        <th>Статус</th>
        <th>Проект</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Count != 0)
    {
        foreach (Tasks task in Model)
        {
            <tr>
                <td>@task.title</td>
                <td>@task.deadline.ToString("dd.MM.yyyy")</td>
                <td>@task.status.name</td>
                <td>@task.campaign.name</td>
                <td>
                    <a asp-action="Delete" asp-controller="Tasks" asp-route-id="@task.id" class="btn btn-sm btn-danger">Удалить</a>
                    <a asp-action="Details" asp-controller="Tasks" asp-route-id="@task.id" class="btn btn-sm btn-info">Подробно</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>