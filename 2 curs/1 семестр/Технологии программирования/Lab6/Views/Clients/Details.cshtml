@model Client

@{
    ViewData["Title"] = "Информация о клиенте";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">
                        <i class="fas fa-building"></i> Информация о клиенте
                    </h2>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">ID:</dt>
                                <dd class="col-sm-8">@Model.id</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.companyName):</dt>
                                <dd class="col-sm-8">@Model.companyName</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.contactPerson):</dt>
                                <dd class="col-sm-8">@Model.contactPerson</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.email):</dt>
                                <dd class="col-sm-8">
                                    <a href="mailto:@Model.email">@Model.email</a>
                                </dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.phone):</dt>
                                <dd class="col-sm-8">
                                    <a href="tel:@Model.phone">@Model.phone</a>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <dt>@Html.DisplayNameFor(model => model.address):</dt>
                            <dd>@Model.address</dd>
                        </div>
                    </div>

                    @if (Model.projects != null && Model.projects.Any())
                    {
                        <div class="row">
                            <div class="col-12">
                                <h5 class="mb-3">
                                    <i class="fas fa-bullhorn"></i> Рекламные кампании
                                    <span class="badge bg-secondary">@Model.projects.Count</span>
                                </h5>

                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Название кампании</th>
                                                <th>Дата начала</th>
                                                <th>Дата окончания</th>
                                                <th>Бюджет</th>
                                                <th>Статус</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var campaign in Model.projects)
                                            {
                                                <tr>
                                                    <td>@campaign.name</td>
                                                    <td>@campaign.startDate.ToString("dd.MM.yyyy")</td>
                                                    <td>@campaign.endDate.ToString("dd.MM.yyyy")</td>
                                                    <td>@campaign.budget.ToString("C")</td>
                                                    <td>@campaign.status.name</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> У этого клиента пока нет рекламных кампаний.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <div class="btn-group" role="group">
                        <a asp-controller="Clients" asp-action="EditPage" asp-route-id="@Model.id"
                           class="btn btn-warning">
                            <i class="fas fa-edit"></i> Редактировать
                        </a>
                        <a asp-controller="Clients" asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Назад к списку
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>