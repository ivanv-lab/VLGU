@model List<Projects>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">
            <i class="bi bi-kanban me-2"></i>Список проектов
        </h4>
        <a asp-action="CreatePage" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Добавить проект
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-kanban me-1"></i>Наименование проекта</th>
                        <th><i class="bi bi-currency-dollar me-1"></i>Бюджет</th>
                        <th><i class="bi bi-calendar-start me-1"></i>Начало</th>
                        <th><i class="bi bi-calendar-end me-1"></i>Окончание</th>
                        <th><i class="bi bi-circle-fill me-1"></i>Статус</th>
                        <th class="text-center">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count != 0)
                    {
                        foreach (Projects project in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@project.name</td>
                                <td>@project.budget.ToString("C")</td>
                                <td>@project.startDate.ToString("dd.MM.yyyy")</td>
                                <td>@project.endDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge
                                                        @(project.status.name == "Активный" ? "bg-success" :
                                                                                                                              project.status.name == "Завершен" ? "bg-secondary" :
                                                                                                                              project.status.name == "Приостановлен" ? "bg-warning" :
                                                                                                                              "bg-info")">
                                        @project.status.name
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-controller="Projects" asp-route-id="@project.id"
                                           class="btn btn-outline-info" title="Подробнее">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-controller="Projects" asp-route-id="@project.id"
                                           class="btn btn-outline-danger" title="Удалить"
                                           onclick="return confirm('Вы уверены, что хотите удалить этот проект?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                                Проекты не найдены
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>